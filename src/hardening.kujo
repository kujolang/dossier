from src.common import get, has, canonical_json

export func packet_manifest(packet) {
    if type(packet)!="dict"||type(get(packet,"claims",null))!="array"||len(packet["claims"])==0||len(packet["claims"])>10000{return {"ok":false,"error":"packet claims must contain 1..10000 entries"}}
    payload:=canonical_json(packet);return {"ok":true,"algorithm":"sha256","packet_sha256":sha256(payload),"claims":len(packet["claims"])}
}
export func sign_packet(packet,signing_key){packet_receipt:=packet_manifest(packet);if !packet_receipt["ok"]||type(signing_key)!="string"||len(signing_key)<16{return {"ok":false,"error":"valid packet and explicit 16+ byte signing key required"}};packet_receipt["signature_algorithm"]="hmac-sha256";packet_receipt["signature"]=hmac_sha256(signing_key,canonical_json(packet));return packet_receipt}
export func verify_packet(packet,signed_manifest,verification_key){expected:=sign_packet(packet,verification_key);if !expected["ok"]{return false};if get(signed_manifest,"packet_sha256","")!=expected["packet_sha256"]{return false};if get(signed_manifest,"signature","")!=expected["signature"]{return false};return true}

export func freshness_status(policy,source_class,claim_class,age_days){if type(policy)!="dict"||age_days<0{return {"ok":false,"error":"policy and non-negative age_days required"}};source_limits:=get(policy,"source_classes",{});claim_limits:=get(policy,"claim_classes",{});source_days:=get(source_limits,source_class,-1);claim_days:=get(claim_limits,claim_class,-1);if source_days<0||claim_days<0{return {"ok":false,"error":"freshness class is not configured"}};limit:=source_days;if claim_days<limit{limit=claim_days};mut status:="expired";if age_days<=limit{status="fresh"};return {"ok":true,"status":status,"age_days":age_days,"maximum_age_days":limit}}

export func citation(format,source){if type(source)!="dict"{return {"ok":false,"error":"source must be an object"}};author:=get(source,"author","");title:=get(source,"title","");year:=get(source,"year","");locator:=get(source,"locator","");if author==""||title==""||year==""||locator==""{return {"ok":false,"error":"author, title, year, and locator are required"}};mut rendered:="";if format=="apa"{rendered=author+" ("+year+"). "+title+". "+locator}else if format=="mla"{rendered=author+". \""+title+".\" "+year+", "+locator}else if format=="chicago"{rendered=author+". \""+title+".\" "+locator+" ("+year+")."}else{return {"ok":false,"error":"unsupported citation format"}};if len(rendered)>4096{return {"ok":false,"error":"citation exceeds 4 KiB"}};return {"ok":true,"format":format,"citation":rendered,"offline":true}}

export func encrypt_packet(input_path,output_path,key){if !path_is_file(input_path)||path_is_symlink(input_path)||file_exists(output_path){return {"ok":false,"error":"safe input and new output path required"}};if type(key)!="string"||len(key)!=32{return {"ok":false,"error":"an explicit 32-byte key is required"}};receipt:=aes_encrypt_file_stream(input_path,output_path,key,1048576);return {"ok":true,"receipt":receipt}}
export func decrypt_packet(input_path,output_path,key){if !path_is_file(input_path)||path_is_symlink(input_path)||file_exists(output_path){return {"ok":false,"error":"safe input and new output path required"}};if type(key)!="string"||len(key)!=32{return {"ok":false,"error":"an explicit 32-byte key is required"}};receipt:=aes_decrypt_file_stream(input_path,output_path,key);return {"ok":true,"receipt":receipt}}

export func streaming_packet_report(claims,batch_size){if type(claims)!="array"||len(claims)>10000||batch_size<1||batch_size>1000{return {"ok":false,"error":"claims or batch size exceed limits"}};mut verified:=0;mut batches:=0;mut i:=0;while i<len(claims){if get(claims[i],"classification","")=="verified"{verified=verified+1};if i%batch_size==0{batches=batches+1};i=i+1};return {"ok":true,"claims":len(claims),"verified":verified,"batches":batches}}

export func benchmark_packet_stream(claim_count,batch_size){if claim_count<10000||claim_count>100000||batch_size<1||batch_size>1000{return {"ok":false,"error":"benchmark requires 10000..100000 claims and a bounded batch"}};mut verified:=0;mut batches:=0;for i in range(claim_count){if i%2==0{verified=verified+1};if i%batch_size==0{batches=batches+1}};return {"ok":true,"claims":claim_count,"verified":verified,"batches":batches,"synthetic":true}}

export func retention_receipt(record,policy,now_day){if type(record)!="dict"||type(policy)!="dict"||now_day<0{return {"ok":false,"error":"record, policy, and logical clock are required"}};created_day:=get(record,"created_day",-1);retention_days:=get(policy,get(record,"record_type","default"),get(policy,"default",-1));if created_day<0||retention_days<0{return {"ok":false,"error":"retention inputs are incomplete"}};expired:=now_day-created_day>retention_days;fields:=get(policy,"redact_fields",[]);mut candidates:=[];for field in fields{if has_key(record,field)==1{candidates=push(candidates,field)}};mut action:="retain";mut redacted:=[];if expired{action="redact";redacted=candidates};return {"ok":true,"action":action,"record_id":get(record,"id",""),"redacted_fields":redacted,"policy_version":get(policy,"version","")}}
