from src.common import get, has, canonical_json, utf8_size

func valid_packet(packet) {
    return type(packet) == "dict" && type(get(packet, "claims", null)) == "array" && len(packet["claims"]) > 0 && len(packet["claims"]) <= 10000
}

func manifest_for(packet, payload) {
    return {"ok": true, "algorithm": "sha256", "packet_sha256": sha256(payload), "claims": len(packet["claims"])}
}

export func packet_manifest(packet) {
    if !valid_packet(packet) { return {"ok": false, "error": "packet claims must contain 1..10000 entries"} }
    return manifest_for(packet, canonical_json(packet))
}

export func sign_packet(packet, signing_key) {
    if !valid_packet(packet) || type(signing_key) != "string" || utf8_size(signing_key) < 16 { return {"ok": false, "error": "valid packet and explicit 16+ byte signing key required"} }
    payload := canonical_json(packet)
    receipt := manifest_for(packet, payload)
    receipt["signature_algorithm"] = "hmac-sha256"
    receipt["signature"] = hmac_sha256(signing_key, payload)
    return receipt
}
export func verify_packet(packet,signed_manifest,verification_key){expected:=sign_packet(packet,verification_key);if !expected["ok"]{return false};if get(signed_manifest,"packet_sha256","")!=expected["packet_sha256"]{return false};if get(signed_manifest,"signature","")!=expected["signature"]{return false};return true}

func nonnegative_number(value) {
    return (type(value) == "int" || type(value) == "float") && value >= 0 && value - value == 0
}

export func freshness_status(policy, source_class, claim_class, age_days) {
    if type(policy) != "dict" || type(source_class) != "string" || type(claim_class) != "string" || !nonnegative_number(age_days) { return {"ok": false, "error": "policy, class names, and non-negative finite age_days required"} }
    source_days := get(get(policy, "source_classes", {}), source_class, -1)
    claim_days := get(get(policy, "claim_classes", {}), claim_class, -1)
    if !nonnegative_number(source_days) || !nonnegative_number(claim_days) { return {"ok": false, "error": "freshness class must have a non-negative finite ceiling"} }
    limit := source_days; if claim_days < limit { limit = claim_days }
    status := "expired"; if age_days <= limit { status = "fresh" }
    return {"ok": true, "status": status, "age_days": age_days, "maximum_age_days": limit}
}

export func citation(format, source) {
    if type(source) != "dict" { return {"ok": false, "error": "source must be an object"} }
    for field in ["author", "title", "year", "locator"] {
        value := get(source, field, "")
        if type(value) != "string" || trim(value) == "" { return {"ok": false, "error": "author, title, year, and locator must be non-empty strings"} }
        if utf8_size(value) > 4096 { return {"ok": false, "error": "citation exceeds 4 KiB"} }
    }
    author := source["author"]; title := source["title"]; year := source["year"]; locator := source["locator"]
    rendered := ""
    if format == "apa" { rendered = author + " (" + year + "). " + title + ". " + locator }
    else if format == "mla" { rendered = author + ". \"" + title + "\". " + year + ", " + locator }
    else if format == "chicago" { rendered = author + ". \"" + title + "\". " + locator + " (" + year + ")." }
    else { return {"ok": false, "error": "unsupported citation format"} }
    if utf8_size(rendered) > 4096 { return {"ok": false, "error": "citation exceeds 4 KiB"} }
    return {"ok": true, "format": format, "citation": rendered, "offline": true}
}

export func encrypt_packet(input_path,output_path,key){if type(input_path)!="string"||type(output_path)!="string"||!path_is_file(input_path)||path_is_symlink(input_path)||file_exists(output_path){return {"ok":false,"error":"safe input and new output path required"}};if type(key)!="string"||utf8_size(key)!=32{return {"ok":false,"error":"an explicit 32-byte key is required"}};try { receipt:=aes_encrypt_file_stream(input_path,output_path,key,1048576);return {"ok":true,"receipt":receipt} } except error { return {"ok":false,"error":"packet encryption failed: "+to_string(error)} }}
export func decrypt_packet(input_path,output_path,key){if type(input_path)!="string"||type(output_path)!="string"||!path_is_file(input_path)||path_is_symlink(input_path)||file_exists(output_path){return {"ok":false,"error":"safe input and new output path required"}};if type(key)!="string"||utf8_size(key)!=32{return {"ok":false,"error":"an explicit 32-byte key is required"}};try { receipt:=aes_decrypt_file_stream(input_path,output_path,key);return {"ok":true,"receipt":receipt} } except error { return {"ok":false,"error":"packet decryption failed: "+to_string(error)} }}

export func streaming_packet_report(claims,batch_size){if type(claims)!="array"||len(claims)>10000||type(batch_size)!="int"||batch_size<1||batch_size>1000{return {"ok":false,"error":"claims or batch size exceed limits"}};mut verified:=0;mut batches:=0;mut i:=0;while i<len(claims){if get(claims[i],"classification","")=="verified"{verified=verified+1};if i%batch_size==0{batches=batches+1};i=i+1};return {"ok":true,"claims":len(claims),"verified":verified,"batches":batches}}

export func benchmark_packet_stream(claim_count,batch_size){if type(claim_count)!="int"||claim_count<10000||claim_count>100000||type(batch_size)!="int"||batch_size<1||batch_size>1000{return {"ok":false,"error":"benchmark requires 10000..100000 claims and a bounded batch"}};mut verified:=0;mut batches:=0;for i in range(claim_count){if i%2==0{verified=verified+1};if i%batch_size==0{batches=batches+1}};return {"ok":true,"claims":claim_count,"verified":verified,"batches":batches,"synthetic":true}}

export func retention_receipt(record, policy, now_day) {
    if type(record) != "dict" || type(policy) != "dict" || !nonnegative_number(now_day) { return {"ok": false, "error": "record, policy, and non-negative finite logical clock are required"} }
    kind := get(record, "record_type", "default")
    if type(kind) != "string" { return {"ok": false, "error": "record_type must be a string"} }
    created_day := get(record, "created_day", -1)
    retention_days := get(policy, kind, get(policy, "default", -1))
    if !nonnegative_number(created_day) || !nonnegative_number(retention_days) { return {"ok": false, "error": "retention days must be non-negative finite numbers"} }
    fields := get(policy, "redact_fields", [])
    if type(fields) != "array" { return {"ok": false, "error": "redact_fields must be an array of strings"} }
    candidates := []
    for field in fields {
        if type(field) != "string" { return {"ok": false, "error": "redact_fields must be an array of strings"} }
        if has_key(record, field) == 1 { candidates = push(candidates, field) }
    }
    action := "retain"; redacted := []
    if now_day - created_day > retention_days { action = "redact"; redacted = candidates }
    return {"ok": true, "action": action, "record_id": get(record, "id", ""), "redacted_fields": redacted, "policy_version": get(policy, "version", "")}
}
