{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dossier event-history page",
  "type": "object",
  "required": ["events", "warnings", "truncated", "next_after"],
  "additionalProperties": false,
  "properties": {
    "events": {"type": "array", "maxItems": 1000, "items": {
      "type": "object", "required": ["event_id", "event"], "additionalProperties": false,
      "properties": {
        "event_id": {"type": "string", "pattern": "^([a-f0-9]{24}|[a-f0-9]{32})$"},
        "event": {"type": "object", "required": ["schema_version", "event", "record_id", "actor", "at"],
          "properties": {"schema_version": {"const": "1.0.0"}, "event": {"const": "record.created"}, "record_id": {"type": "string"}, "actor": {"type": "string"}, "at": {"type": "string"}, "checksum": {"type": "string"}, "record_sha256": {"type": "string"}},
          "anyOf": [{"required": ["checksum"]}, {"required": ["record_sha256"]}]
        }
      }
    }},
    "warnings": {"type": "array", "maxItems": 1000, "items": {"type": "object", "required": ["id", "code", "error"], "properties": {"id": {"type": "string"}, "code": {"type": "string"}, "error": {"type": "string"}}}},
    "truncated": {"type": "boolean"},
    "next_after": {"type": "string"}
  }
}
