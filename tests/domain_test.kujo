from tests.support import cleanup
from src.core import dispatch
from src.args import parse_args
mut passed:=0;mut failed:=0
func check(ok,label){if ok{passed=passed+1}else{failed=failed+1;eprint("FAIL: "+label)}}
func opts(values){return parse_args(values,["json","dry-run","force"])}
root:="/tmp/dossier-domain-"+uuid_v4()
bad:=root+"-bad.json";write_file(bad,"{\"schema_version\":\"1.0.0\",\"claim_text\":\"Unsupported certainty\",\"claim_kind\":\"factoid\"}",true)
check(!dispatch("claim add",opts(["--state",root,"--input",bad,"--actor","editor"]))["ok"],"claim taxonomy enforced")
source:=root+"-source.json";write_file(source,"{\"schema_version\":\"1.0.0\",\"locator\":\"fixture:source:1\",\"source_type\":\"document\",\"retrieved_at\":\"2026-08-14T00:00:00Z\"}",true)
check(dispatch("source add",opts(["--state",root,"--input",source,"--actor","researcher","--id","source-fixture","--timestamp","2026-08-14T03:00:00Z"]))["ok"],"source contract")
evidence:=root+"-evidence.json";write_file(evidence,"{\"schema_version\":\"1.0.0\",\"claim_id\":\"claim-fixture\",\"source_id\":\"source-fixture\",\"source_location\":\"line 1\",\"captured_support\":\"Exact offline fixture support.\",\"checksum\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"classification\":\"verified\",\"retrieved_at\":\"2026-08-14T00:00:00Z\",\"reviewed_by\":\"standards-editor\"}",true)
check(dispatch("evidence attach",opts(["--state",root,"--input",evidence,"--actor","standards-editor","--id","evidence-fixture","--timestamp","2026-08-14T03:00:01Z"]))["ok"],"verified evidence contract")
weak:=root+"-weak.json";write_file(weak,"{\"schema_version\":\"1.0.0\",\"claim_id\":\"claim-fixture\",\"source_id\":\"source-fixture\",\"source_location\":\"line 1\",\"captured_support\":\"\",\"checksum\":\"abc123\",\"classification\":\"verified\",\"retrieved_at\":\"2026-08-14T00:00:00Z\",\"reviewed_by\":\"standards-editor\"}",true)
check(!dispatch("evidence attach",opts(["--state",root,"--input",weak,"--actor","standards-editor"]))["ok"],"verification cannot be inferred from locator")
conflict:=root+"-conflict.json";write_file(conflict,"{\"schema_version\":\"1.0.0\",\"claim_id\":\"claim-fixture\",\"description\":\"Sources disagree\",\"source_ids\":[\"source-a\"]}",true)
check(!dispatch("conflict add",opts(["--state",root,"--input",conflict,"--actor","standards-editor"]))["ok"],"conflict needs independent sources")
check(dispatch("validate",opts(["--state",root]))["ok"],"stored records validate")
for path in [bad,source,evidence,weak,conflict]{if file_exists(path){delete_file(path)}}
cleanup(root)
print(to_string(passed)+" passed; "+to_string(failed)+" failed");if failed>0{exit(1)}
