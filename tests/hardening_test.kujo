from src.hardening import packet_manifest, sign_packet, verify_packet, freshness_status, citation, encrypt_packet, decrypt_packet, streaming_packet_report, benchmark_packet_stream, retention_receipt
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
packet:={"claims":[{"id":"claim-one","classification":"verified"}]};signed:=sign_packet(packet,"fixture-key-123456");check(signed["ok"]&&verify_packet(packet,signed,"fixture-key-123456"),"signed packet");drift_valid:=verify_packet({"claims":[{"id":"changed"}]},signed,"fixture-key-123456");check(drift_valid==false,"detached drift")
check(!verify_packet(packet, signed, "wrong-fixture-key-123456"), "wrong signing key rejected")
policy:={"source_classes":{"primary":30},"claim_classes":{"fact":7}};check(freshness_status(policy,"primary","fact",6)["status"]=="fresh","freshness fresh");check(freshness_status(policy,"primary","fact",8)["status"]=="expired","freshness expired")
source:=parse_json(read_file("fixtures/citations/source.json"));for format in ["apa","mla","chicago"]{check(citation(format,source)["ok"],"citation "+format)}
root:="/tmp/dossier-encryption-"+uuid_v4();plain:=root+".json";encrypted:=root+".aead";restored:=root+".restored";write_file(plain,to_json(packet),true);check(encrypt_packet(plain,encrypted,"0123456789abcdef0123456789abcdef")["ok"],"encrypt");check(decrypt_packet(encrypted,restored,"0123456789abcdef0123456789abcdef")["ok"]&&read_file(restored)==read_file(plain),"decrypt")
check(!encrypt_packet(plain, root + ".bad-key", repeat("é", 32))["ok"], "encryption key is 32 bytes, not 32 characters")
mut rejected := false
try { result := decrypt_packet(encrypted, root + ".wrong-key", "abcdef0123456789abcdef0123456789"); rejected = !result["ok"] } except error { rejected = true }
check(rejected && !file_exists(root + ".wrong-key"), "authentication failure publishes no plaintext")
claims:=[{"classification":"verified"},{"classification":"observed"}];report:=streaming_packet_report(claims,1);check(report["ok"]&&report["batches"]==2&&report["verified"]==1,"packet stream");benchmark:=benchmark_packet_stream(100000,500);check(benchmark["ok"]&&benchmark["batches"]==200&&benchmark["verified"]==50000,"large corpus stream")
receipt:=retention_receipt({"id":"feedback-one","record_type":"feedback","created_day":1,"subject":"private"},{"version":"1","default":90,"feedback":30,"redact_fields":["subject"]},40);check(receipt["action"]=="redact"&&receipt["redacted_fields"]==["subject"],"redaction receipt")
for path in [plain,encrypted,restored]{delete_file(path)};print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
