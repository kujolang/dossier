// Runtime dependency fixture. Receipts are checked by crypto_contention.sh.
from src.hardening import encrypt_packet, decrypt_packet
mode := args()[0]; root := args()[1]
if mode == "prepare" {
    create_dir(root)
    write_file(root + "/one", repeat("a", 8388608), false)
    write_file(root + "/two", repeat("b", 8388608), false)
    for name in ["one", "two"] {
        result := encrypt_packet(root + "/" + name, root + "/" + name + ".aead", "0123456789abcdef0123456789abcdef")
        if !result["ok"] { eprint(to_json(result)); exit(1) }
    }
} else if mode == "one" || mode == "two" {
    print(to_json(encrypt_packet(root + "/" + mode, root + "/shared.aead", "0123456789abcdef0123456789abcdef")))
} else if mode == "decrypt-one" || mode == "decrypt-two" {
    name := substring(mode, 8, len(mode))
    print(to_json(decrypt_packet(root + "/" + name + ".aead", root + "/shared-plain", "0123456789abcdef0123456789abcdef")))
} else if mode == "read" {
    result := decrypt_packet(root + "/shared.aead", root + "/restored", "0123456789abcdef0123456789abcdef")
    print(to_json(result))
} else { exit(2) }
